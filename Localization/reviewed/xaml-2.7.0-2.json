iewed","source_hash":"cd36da60f23e09cc09583b21f7c00d917a83df2d01c2c36be1ccb8bf1a74752f"},"Dynamic Range":{"translation":"动态范围","state":"reviewed","source_hash":"ebbc76eca09aad08920ba62454bcbdbb1b4e643892b5a298bb52cc7f90b8c81d"},"Full":{"translation":"完全","state":"reviewed","source_hash":"008dacb6d1e85bd8c0ae9661c4472810ef75537f690dd75d77fc74ca62f78fec"},"Limited":{"translation":"有限","state":"reviewed","source_hash":"e5125d9f63d2947b5540a0f96b768bea4bcce632d9869d2a75749bbd513142c3"},"Nexus Mods":{"translation":"Nexus Mods","state":"reviewed","source_hash":"e15b0298d3b42565149d5db793ff000691eb48591bfd031269ec3717e5958117"},"API Key":{"translation":"API Key","state":"reviewed","source_hash":"23189d55f6973f2ce5325707ab40ed9a145fd5b71f0f009448f0c15fc22b3d73"},"Paste your Nexus Mods personal API key. Premium users get one-click downloads and silent auto-updates. Free users get one-click browser downloads.":{"translation":"粘贴你的 Nexus Mods 个人 API Key。Premium 用户可一键下载并静默自动更新；免费用户可一键打开浏览器下载。","state":"reviewed","source_hash":"43cc5332a5cebd55a8ee118d6ab66a7daa0031e9d8b209c590e000dd13d875d0"},"NXM Protocol Handler":{"translation":"NXM 协议处理程序","state":"reviewed","source_hash":"cbbb0c17d01fc1f4a3cddce93a74a85c7ccb76c538af91a6efa0b8c171d87075"},"Register RHI as the nxm:// handler so Nexus \"Mod Manager Download\" buttons open directly in RHI.":{"translation":"将 RHI 注册为 nxm:// 协议处理程序，使 Nexus 的“Mod Manager Download”按钮可直接在 RHI 中打开。","state":"reviewed","source_hash":"3beab188533fa97b974019acd2c4844c206c254b11fb0c63dcc700768ed330f9"},"Connect":{"translation":"连接","state":"reviewed","source_hash":"1a2303ede07493acc7caaa7c737f3c52bcc9cf04372be19ed1b0af6b9f2c791e"},"Not connected":{"translation":"未连接","state":"reviewed","source_hash":"0303e182467081801f8b614862519a3b174c0ae84ff08b70e7d126080c3f4b95"},"Not registered":{"translation":"未注册","state":"reviewed","source_hash":"ca374c23ed92ea8230cdcdea8bc85b922fa98ba64ff0f5adbf65def3bd650164"},"Register":{"translation":"注册","state":"reviewed","s